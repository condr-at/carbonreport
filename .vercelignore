# Vercel Ignore
# Files/directories to exclude from Vercel deployment

# Documentation
docs/
*.md
!README.md

# Development files
.env
.env.local
.env.*.local

# Tests (when added)
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Scripts
scripts/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# Prisma artifacts (generated during build)
prisma/migrations/

# Node modules (Vercel handles this)
node_modules/
