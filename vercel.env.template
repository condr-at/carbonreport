# Vercel Environment Variables Template
# 
# INSTRUCTIONS:
# 1. Copy this file: cp vercel.env.template .env.vercel
# 2. Replace placeholders with real values (DATABASE_URL, JWT_SECRET)
# 3. Import .env.vercel in Vercel Dashboard → Settings → Environment Variables → Import .env
#
# ⚠️ DO NOT COMMIT .env.vercel TO GIT! (already in .gitignore)
#
# Format for Vercel: KEY=value (no quotes)

DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_32
JWT_ACCESS_TOKEN_EXPIRES_IN=24h
JWT_REFRESH_TOKEN_EXPIRES_IN=90d
RESEND_API_KEY=re_UH78eSQ5_GHn1e8TB7Kz8cQKPnssQPvtA
FROM_EMAIL=noreply@carbonreport.app
NEXT_PUBLIC_APP_URL=https://carbonreport.app
NEXT_PUBLIC_LAZY_DATASET=false
NEXT_PUBLIC_LAZY_DATA_REQUESTS=false
NODE_ENV=production
ASSETS_BUCKET_NAME=your-assets-bucket
ASSETS_BUCKET_REGION=us-east-1
ASSETS_PUBLIC_BASE_URL=https://your-assets-bucket.s3.us-east-1.amazonaws.com
ASSETS_UPLOADS_PREFIX=uploads
ASSETS_UPLOAD_TTL_SECONDS=60
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Choose how we sign uploads: "post" (default S3 form) or "put" for providers like Cloudflare R2
ASSETS_S3_UPLOAD_STRATEGY=post
# Optional session token for temporary credentials
AWS_SESSION_TOKEN=
# Local dev upload overrides (leave blank/false on Vercel)
ENABLE_LOCAL_UPLOADS=false
LOCAL_UPLOADS_DIR=./public/dev-uploads
LOCAL_UPLOADS_PUBLIC_PATH=/dev-uploads
LOCAL_UPLOADS_PUBLIC_URL=http://localhost:3000/dev-uploads

