# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/carbonreport?schema=public"

# JWT Authentication
JWT_SECRET="your-secret-key-min-32-characters-long-change-in-production"
JWT_ACCESS_TOKEN_EXPIRES_IN="24h"
JWT_REFRESH_TOKEN_EXPIRES_IN="90d"

# Email Service (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="noreply@yourdomain.com"

# S3-Compatible Storage (AWS S3 or MinIO)
S3_ENDPOINT="https://s3.amazonaws.com" # Or MinIO endpoint
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="carbonreport-files"
S3_PUBLIC_URL="" # Optional: CDN URL for public file access

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# File Upload Limits
MAX_FILE_SIZE_MB=10
