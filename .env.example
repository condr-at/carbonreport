# Database Configuration
# For local development with Docker:
# DATABASE_URL="postgresql://carbonreport:carbonreport_dev@localhost:5432/carbonreport?schema=public"

# For Supabase (recommended):
# Session Pooler (port 5432) - for migrations and development
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Transaction Pooler (port 6543) - for production runtime (Vercel)
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT Authentication
JWT_SECRET="your-secret-key-min-32-characters-long-change-in-production"
JWT_ACCESS_TOKEN_EXPIRES_IN="24h"
JWT_REFRESH_TOKEN_EXPIRES_IN="90d"

# Email Service (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="noreply@yourdomain.com"

# S3-Compatible Storage (AWS S3 or MinIO)
S3_ENDPOINT="https://s3.amazonaws.com" # Or MinIO endpoint
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="carbonreport-files"
S3_PUBLIC_URL="" # Optional: CDN URL for public file access

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# File Upload Limits
MAX_FILE_SIZE_MB=10
