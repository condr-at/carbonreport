// Prisma schema for Carbon Report Platform
// Multi-organization model per docs/ARCHITECTURE.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================================
// Enumerations
// ================================

enum OrganizationStatus {
  ACTIVE           @map("active")
  DELETED          @map("deleted")
  PENDING_TRANSFER @map("pending_transfer")

  @@map("organization_status")
}

enum OrganizationMembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER_READONLY
  VIEWER_VERIFIER

  @@map("organization_membership_role")
}

enum OrganizationMembershipInviteStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
  REVOKED  @map("revoked")

  @@map("organization_membership_invite_status")
}

enum AssetType {
  ORG_LOGO    @map("org_logo")
  USER_AVATAR @map("user_avatar")

  @@map("asset_type")
}

enum ProjectStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")
  REPORTED @map("reported")
  DELETED  @map("deleted")

  @@map("project_status")
}

// ================================
// Users & Authentication
// ================================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  emailVerified Boolean   @default(false) @map("email_verified")
  avatarUrl     String?   @map("avatar_url")
  oauthProvider String?   @map("oauth_provider") // google, microsoft
  oauthId       String?   @map("oauth_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  dataRequests DataRequest[]

  memberships           OrganizationMembership[]
  membershipInvitesSent OrganizationMembership[] @relation("MembershipInviter")
  organizationsCreated  Organization[]           @relation("OrganizationCreatedBy")
  projectsCreated       Project[]                @relation("ProjectCreatedBy")
  contactsCreated       Contact[]                @relation("ContactCreatedBy")
  assetsUploaded        Asset[]                  @relation("AssetUploadedBy")

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

// ================================
// Plans & Organizations
// ================================

model PlanDefinition {
  planCode          String   @id @map("plan_code")
  label             String
  description       String?
  maxActiveProjects Int      @map("max_active_projects")
  maxEditors        Int      @map("max_editors")
  maxVerifiers      Int      @map("max_verifiers")
  maxViewers        Int?     @map("max_viewers")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organizations Organization[]

  @@map("plan_definitions")
}

model Organization {
  id              String             @id @default(uuid())
  slug            String             @unique
  displayName     String             @map("display_name")
  description     String?
  planCode        String             @map("plan_code")
  planAssignedAt  DateTime           @map("plan_assigned_at")
  planValidUntil  DateTime?          @map("plan_valid_until")
  logoAssetId     String?            @map("logo_asset_id")
  logoUrl         String?            @map("logo_url")
  createdByUserId String             @map("created_by_user_id")
  status          OrganizationStatus @default(ACTIVE)
  deletedAt       DateTime?          @map("deleted_at")
  metadata        Json?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  plan      PlanDefinition @relation(fields: [planCode], references: [planCode])
  logoAsset Asset?         @relation("OrganizationLogo", fields: [logoAssetId], references: [id])
  createdBy User           @relation("OrganizationCreatedBy", fields: [createdByUserId], references: [id])

  memberships    OrganizationMembership[]
  projects       Project[]
  usageSnapshots OrganizationUsageSnapshot[]
  contacts       Contact[]

  @@index([planCode])
  @@map("organizations")
}

model OrganizationMembership {
  id              String                             @id @default(uuid())
  organizationId  String                             @map("organization_id")
  userId          String                             @map("user_id")
  role            OrganizationMembershipRole
  inviteStatus    OrganizationMembershipInviteStatus @default(PENDING) @map("invite_status")
  invitedByUserId String?                            @map("invited_by_user_id")
  joinedAt        DateTime?                          @map("joined_at")
  lastActiveAt    DateTime?                          @map("last_active_at")
  createdAt       DateTime                           @default(now()) @map("created_at")
  updatedAt       DateTime                           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  invitedBy    User?        @relation("MembershipInviter", fields: [invitedByUserId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId, role, inviteStatus])
  @@map("organization_memberships")
}

model OrganizationUsageSnapshot {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  computedAt      DateTime @map("computed_at")
  activeProjects  Int      @map("active_projects")
  activeEditors   Int      @map("active_editors")
  activeVerifiers Int      @map("active_verifiers")
  activeViewers   Int      @map("active_viewers")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, computedAt(sort: Desc)])
  @@map("organization_usage_snapshots")
}

model Asset {
  id               String    @id @default(uuid())
  type             AssetType
  url              String
  fileName         String    @map("file_name")
  mimeType         String    @map("mime_type")
  fileSizeBytes    Int       @map("file_size_bytes")
  uploadedByUserId String    @map("uploaded_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  uploadedBy    User           @relation("AssetUploadedBy", fields: [uploadedByUserId], references: [id])
  organizations Organization[] @relation("OrganizationLogo")

  @@index([uploadedByUserId])
  @@map("assets")
}

// ================================
// Projects
// ================================

model Project {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  createdByUserId String        @map("created_by_user_id")
  name            String
  dataset         Json // JSONB: { data_points: [...] }
  datasetVersion  Int           @default(0) @map("dataset_version") // Optimistic locking
  mailtoTemplate  Json?         @map("mailto_template")
  checklist       Json
  status          ProjectStatus @default(ACTIVE)
  twinProjectId   String?       @map("twin_project_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  deletedAt       DateTime?     @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  createdBy    User          @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])
  twinProject  Project?      @relation("TwinProjects", fields: [twinProjectId], references: [id])
  twinProjects Project[]     @relation("TwinProjects")
  reports      Report[]
  dataRequests DataRequest[]

  @@index([organizationId, status])
  @@index([status, deletedAt])
  @@map("projects")
}

// ================================
// Reports
// ================================

model Report {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  templateCode String   @map("template_code") // "ISO14067", "CBAM", etc.
  metadata     Json? // Optional: custom settings, field visibility overrides
  completion   Float    @default(0) // 0-100%
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ReportTemplate   ReportTemplate? @relation(fields: [reportTemplateId], references: [id])
  reportTemplateId String?

  @@map("reports")
}

model ReportTemplate {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., "ISO14067"
  name        String
  version     String?
  description String?
  layoutMeta  Json?    @map("layout_meta") // Arbitrary layout configuration
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  sections ReportTemplateSection[]
  reports  Report[]

  @@map("report_templates")
}

model ReportTemplateSection {
  id          String   @id @default(uuid())
  templateId  String   @map("template_id")
  key         String // e.g., "general_info"
  title       String
  description String?
  blockType   String   @map("block_type") // e.g., component identifier
  config      Json? // Additional per-block configuration
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  template ReportTemplate               @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields   ReportTemplateFieldMapping[]

  @@unique([templateId, key])
  @@map("report_template_sections")
}

model ReportTemplateFieldMapping {
  id                       String   @id @default(uuid())
  sectionId                String   @map("section_id")
  datasetFieldDefinitionId String   @map("dataset_field_definition_id")
  displayLabel             String?  @map("display_label")
  isRequired               Boolean  @default(false) @map("is_required")
  displayOrder             Int      @default(0) @map("display_order")
  config                   Json? // Field-level overrides (hints, placeholders, etc.)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  // Relations
  section  ReportTemplateSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  fieldDef DatasetFieldDefinition @relation(fields: [datasetFieldDefinitionId], references: [id])

  @@unique([sectionId, datasetFieldDefinitionId])
  @@map("report_template_field_mappings")
}

// ================================
// Contacts
// ================================

model Contact {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  createdByUserId String   @map("created_by_user_id")
  name            String
  position        String?
  email           String
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  createdBy    User          @relation("ContactCreatedBy", fields: [createdByUserId], references: [id])
  dataRequests DataRequest[]

  @@map("contacts")
}

// ================================
// Data Requests
// ================================

model DataRequest {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  projectId      String    @map("project_id")
  contactId      String    @map("contact_id")
  dataPointId    String    @map("data_point_id") // field_id from dataset
  itemId         String?   @map("item_id")
  fieldLabel     String?   @map("field_label")
  requestedAt    DateTime  @default(now()) @map("requested_at")
  revokedAt      DateTime? @map("revoked_at")
  completedAt    DateTime? @map("completed_at")
  deadline       DateTime? @map("deadline")
  externalAccess Boolean   @default(false) @map("external_access") // Reserved for future

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id])

  @@map("data_requests")
}

// ================================
// Dataset Field Definitions
// ================================

model DatasetFieldDefinition {
  id                         String                       @id @default(uuid())
  fieldId                    String                       @unique @map("field_id") // e.g., "ProductDescription_ProductName"
  label                      String
  hint                       String?
  type                       String                       @default("text")
  options                    Json?
  validation                 Json?
  isRepeatable               Boolean                      @default(false) @map("is_repeatable")
  repeatableKey              String?                      @map("repeatable_key")
  // Sorting/ordering for UI (ascending); smaller first
  sortOrder                  Int                          @default(0) @map("sort_order")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")
  ReportTemplateFieldMapping ReportTemplateFieldMapping[]

  @@map("dataset_field_definitions")
}

