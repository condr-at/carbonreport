// Prisma schema for Carbon Report Platform
// Based on Requirements v0.0.1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================================
// Users & Authentication
// ================================

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  emailVerified  Boolean   @default(false) @map("email_verified")
  avatarUrl      String?   @map("avatar_url")
  oauthProvider  String?   @map("oauth_provider") // google, microsoft
  oauthId        String?   @map("oauth_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  projects     Project[]
  contacts     Contact[]
  dataRequests DataRequest[]
  // files        ProjectFile[]  // ⏸️ Post-MVP

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

// ================================
// Projects
// ================================

model Project {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  name             String
  dataset          Json          // JSONB: { data_points: [...] }
  datasetVersion   Int           @default(0) @map("dataset_version") // Optimistic locking
  mailtoTemplates  Json?         @map("mailto_templates") // Per-project mailto customization
  checklist        Json          // JSONB: Roadmap steps
  status           ProjectStatus @default(ACTIVE)
  twinProjectId    String?       @map("twin_project_id") // For AI comparison (future)
  createdAt        DateTime      @default(now()) @map("created_at")
  deletedAt        DateTime?     @map("deleted_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  twinProject  Project?      @relation("TwinProjects", fields: [twinProjectId], references: [id])
  twinProjects Project[]     @relation("TwinProjects")
  reports      Report[]
  // files        ProjectFile[]  // ⏸️ Post-MVP
  dataRequests DataRequest[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// ================================
// Reports
// ================================

model Report {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  templateCode String   @map("template_code") // "ISO14067", "CBAM", etc.
  metadata     Json?    // Optional: custom settings, field visibility overrides
  completion   Float    @default(0) // 0-100%
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// ================================
// Contacts
// ================================

model Contact {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  name      String
  position  String?
  email     String
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  dataRequests DataRequest[]

  @@map("contacts")
}

// ================================
// Data Requests
// ================================

model DataRequest {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  projectId      String    @map("project_id")
  contactId      String    @map("contact_id")
  dataPointId    String    @map("data_point_id") // field_id from dataset
  requestedAt    DateTime  @default(now()) @map("requested_at")
  revokedAt      DateTime? @map("revoked_at")
  externalAccess Boolean   @default(false) @map("external_access") // Reserved for future

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id])

  @@map("data_requests")
}

// ================================
// Dataset Field Definitions
// ================================

model DatasetFieldDefinition {
  id            String   @id @default(uuid())
  fieldId       String   @unique @map("field_id") // e.g., "ProductDescription_ProductName"
  label         String
  hint          String?
  type          String   @default("text")
  options       Json?
  validation    Json?
  isRepeatable  Boolean  @default(false) @map("is_repeatable")
  repeatableKey String?  @map("repeatable_key")
  // Sorting/ordering for UI (ascending); smaller first
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("dataset_field_definitions")
}

