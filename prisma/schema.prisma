// Prisma schema for Carbon Report Platform
// Based on Requirements v0.0.1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// Users & Authentication
// ================================

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  emailVerified  Boolean   @default(false) @map("email_verified")
  avatarUrl      String?   @map("avatar_url")
  oauthProvider  String?   @map("oauth_provider") // google, microsoft
  oauthId        String?   @map("oauth_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  projects        Project[]
  contacts        Contact[]
  contactRequests ContactRequest[]
  files           ProjectFile[]

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

// ================================
// Projects
// ================================

model Project {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  name           String
  dataset        Json          // JSONB: { data_points: [...] }
  checklist      Json          // JSONB: Roadmap steps
  status         ProjectStatus @default(ACTIVE)
  twinProjectId  String?       @map("twin_project_id") // For AI comparison (future)
  createdAt      DateTime      @default(now()) @map("created_at")
  deletedAt      DateTime?     @map("deleted_at")

  // Relations
  user            User              @relation(fields: [userId], references: [id])
  twinProject     Project?          @relation("TwinProjects", fields: [twinProjectId], references: [id])
  twinProjects    Project[]         @relation("TwinProjects")
  reports         Report[]
  files           ProjectFile[]
  contactRequests ContactRequest[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// ================================
// Reports
// ================================

model Report {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  templateCode String   @map("template_code") // "ISO14067", "CBAM", etc.
  data         Json     @default("{}") // Filled report data
  completion   Float    @default(0) // 0-100%
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// ================================
// Contacts
// ================================

model Contact {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  name      String
  position  String?
  email     String
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  user     User             @relation(fields: [userId], references: [id])
  requests ContactRequest[]

  @@map("contacts")
}

model ContactRequest {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  projectId      String    @map("project_id")
  contactId      String    @map("contact_id")
  dataPointId    String    @map("data_point_id") // field_id from dataset
  requestedAt    DateTime  @default(now()) @map("requested_at")
  revokedAt      DateTime? @map("revoked_at")
  externalAccess Boolean   @default(false) @map("external_access") // Reserved for future

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id])

  @@map("contact_requests")
}

// ================================
// Files
// ================================

model ProjectFile {
  id               String     @id @default(uuid())
  userId           String     @map("user_id")
  projectId        String     @map("project_id")
  filename         String
  mimeType         String     @map("mime_type")
  size             Int        // bytes
  linkedDataPoints Json       @map("linked_data_points") // JSONB: array of data point IDs
  status           FileStatus @default(UPLOADED)
  uploadedAt       DateTime   @default(now()) @map("uploaded_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

enum FileStatus {
  UPLOADED
  PROCESSED
  LINKED
}
